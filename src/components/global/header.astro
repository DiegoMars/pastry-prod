---
import { Image } from 'astro:assets';
import background from '../../assets/background.jpeg'; 
---
<section class="flex flex-col bg-text-200">
  <section class="px-4 py-6 md:px-8 md:py-8 text-center">
    <Image
      src={background}
      class="absolute inset-0 h-full w-full object-cover -z-10"
      alt=""
    />
    <a href="/">
      <h1 class="pinkFancy text-4xl md:text-7xl inline-block -rotate-2">Amore & Diesel's Delights</h1>
    </a>
  </section>
  <!-- <section class="bg-secondary p-[1rem] shadow-md"> -->
  <section class="bg-gradient-to-b from-secondary-300 to-secondary-500 p-[1rem] shadow-md">
    <nav class="flex justify-center gap-6 md:gap-10 text-xl md:text-2xl max-w-5xl mx-auto">
      <a href="/" class="font-bold text-background border-b-2 border-background">
        Home
      </a>
      <a href="/shop" class="font-bold text-background/80 hover:text-background">
        Shop
      </a>
      <a href="/about" class="font-bold text-background/80 hover:text-background">
        About Us
      </a>
    </nav>
  </section>
</section>
